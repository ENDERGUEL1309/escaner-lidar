LidarScanner/Info.plist

# Compilación
build/
DerivedData/
Payload/
*.ipa
xcodebuild.log

# Xcode / macOS
xcuserdata/
*.xcuserstate
.DS_Store

# Claude Code (configuración local)
.claude/

# Servidor (datos locales del prototipo)
servidor/datos/
servidor/node_modules/

# Trabajador con GPU (Python)
__pycache__/
*.pyc
trabajador-gpu/.venv/

# Secreto compartido servidor <-> GPU (no subir)
servidor/.secreto-interno
